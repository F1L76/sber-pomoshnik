{
  "name": "sberbiznes-pomoshnik",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node gigachat-proxy.mjs",
    "dev": "node gigachat-proxy.mjs",
    "cadastral": "node scripts/cadastral-cli.mjs",
    "geocode-list": "node scripts/geocode-cadastral-list.mjs",
    "geocode-list:missing": "node scripts/geocode-cadastral-list.mjs --missing",
    "geocode-list:awake": "caffeinate -dims node scripts/geocode-cadastral-list.mjs",
    "geocode-list:lid": "bash scripts/geocode-allow-lid.sh",
    "geocode-fallback": "node scripts/geocode-fallback-list.mjs",
    "geocode-fallback:kadbase": "GEOCODE_FALLBACK_KADBASE=1 node scripts/geocode-fallback-list.mjs",
    "geocode-xlsx": "python3 scripts/write-coords-to-xlsx.py",
    "nspd-edge": "node scripts/nspd-edge-proxy.mjs",
    "nspd-tunnel": "bash scripts/start-nspd-tunnel.sh",
    "deals:index": "node scripts/build-deals-quarter-index.mjs",
    "deals:import": "node scripts/import-deals-sqlite.mjs",
    "conclusion-qa:build": "PYTHONPATH=python-deps python3 scripts/build_conclusion_qa.py",
    "conclusion-qa:check": "python3 scripts/check_conclusion_qa.py",
    "gl-load:check": "node scripts/gl-load-selfcheck.mjs",
    "zalog:install": "python3 -m pip install -r requirements-zalog.txt -t python-deps",
    "prestart": "npm run zalog:install",
    "postinstall": "node node_modules/playwright-core/cli.js install chromium || true"
  },
  "dependencies": {
    "playwright-core": "^1.52.0",
    "ws": "^8.18.0"
  }
}
